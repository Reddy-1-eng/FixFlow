# ==============================================================================
# BuildFail-SLM Environment Configuration (.env.example)
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# ==============================================================================

# Hardware & Execution
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Hugging Face Settings
HF_HOME=./cache/huggingface
HF_TOKEN=your_huggingface_token_here

# Base Model Selection (Qwen2.5-Coder-7B-Instruct with QLoRA)
BASE_MODEL_NAME=Qwen/Qwen2.5-Coder-7B-Instruct
ADAPTER_OUTPUT_DIR=krishna1707/buildfail-slm-qwen7b-adapter

# Data Paths
RAW_DATA_DIR=./data/01_raw
SOURCE_CLEAN_DIR=./data/02_source_clean
UNIFIED_DATA_DIR=./data/03_unified
FINETUNING_DATA_DIR=./data/04_finetuning

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000

# Firebase Configuration (Realtime Database & Hosting)
FIREBASE_CREDENTIALS_PATH=./backend/firebase-credentials.json
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=fixflow-beb5b

